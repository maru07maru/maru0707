<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>♡ 本日の要チェックGIRL ♡｜掲載用ページ作成</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,
  "Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif;
  background:linear-gradient(135deg,#efffff,#fff0fb,#f7fff0);
  color:#4b3b52;
}

.wrap{
  max-width:920px;
  margin:auto;
  padding:20px 14px 50px;
}

h1{
  text-align:center;
  color:#ff35b7;
  font-size:27px;
  margin:4px 0 6px;
}

.sub{
  text-align:center;
  color:#777;
  margin:0 0 20px;
  line-height:1.6;
}

.card{
  background:#fff;
  border:2px solid #ff75ca;
  border-radius:20px;
  padding:18px;
  margin:14px 0;
  box-shadow:0 8px 20px #d8c5dc55;
}

.step{
  display:inline-block;
  background:linear-gradient(90deg,#ff55bd,#a66bff);
  color:#fff;
  border-radius:999px;
  padding:5px 12px;
  font-size:12px;
  font-weight:800;
  margin-bottom:10px;
}

label{
  display:block;
  font-weight:800;
  color:#e51aa2;
  margin:10px 0 7px;
}

textarea{
  width:100%;
  min-height:300px;
  border:2px dashed #55c9ee;
  border-radius:14px;
  padding:14px;
  font-size:13px;
  line-height:1.55;
  resize:vertical;
}

input{
  width:100%;
  border:2px solid #dddde8;
  border-radius:13px;
  padding:12px;
  font-size:15px;
}

button{
  width:100%;
  border:0;
  border-radius:14px;
  padding:14px;
  font-size:16px;
  font-weight:800;
  cursor:pointer;
}

.main{
  background:linear-gradient(90deg,#ff55bd,#a66bff);
  color:#fff;
  margin-top:12px;
}

.copy{
  background:#ff4fba;
  color:#fff;
}

.subbtn{
  background:#eef1f6;
  color:#555;
  margin-top:8px;
}

.preview-wrap{
  background:#fff;
  border:1px solid #eee;
  border-radius:16px;
  padding:10px;
}

.preview{
  min-height:250px;
  overflow:hidden;
}

.output{
  min-height:420px;
  font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
  font-size:12px;
}

.note{
  color:#888;
  font-size:12px;
  line-height:1.7;
}

.status{
  display:none;
  margin-top:10px;
  padding:11px 12px;
  border-radius:12px;
  background:#effff4;
  color:#16833a;
  font-weight:700;
  font-size:13px;
}

.help{
  background:#f8ffff;
  border:1px solid #b8eafa;
  border-radius:13px;
  padding:12px;
  font-size:13px;
  line-height:1.7;
}

@media(max-width:600px){

  h1{
    font-size:23px;
  }

  textarea{
    min-height:260px;
  }

}
</style>
</head>


<body>

<div class="wrap">


<h1>♡ 本日の要チェックGIRL ♡</h1>

<p class="sub">
作成した女の子HTMLを貼り付けるだけ。<br>
掲載用の完成HTMLをまとめて作成できます。
</p>


<!-- STEP 1 -->

<div class="card">

<span class="step">
STEP 1
</span>

<label>
作成した女の子HTMLを貼り付け
</label>

<textarea
id="girlHtml"
placeholder="★★★ここに作成した女の子HTMLを貼り付け★★★

1人分でも、複数人分まとめて貼り付けてもOKです。

例：
<div>...</div>
<div>...</div>
<div>...</div>"
></textarea>


<div class="help">

<b>使い方</b><br>

① 女の子用HTMLメーカーでHTMLを作成<br>
② 「HTMLをコピー」<br>
③ この画面の「★★★ここに貼り付け★★★」へ貼り付け<br>
④ 「掲載用ページを作成する」を押す<br>
⑤ 完成HTMLをコピーしてCityHeavenへ貼り付け

</div>


<button
class="main"
onclick="makePage()"
>
✨ 掲載用ページを作成する
</button>


<div
id="status"
class="status"
></div>

</div>


<!-- 店舗情報 -->

<div class="card">

<span class="step">
STEP 2
</span>

<label>
店舗情報
</label>


<input
id="shopName"
value="渋谷さーくる渋谷店"
placeholder="店舗名"
>


<input
id="shopTel"
value="TEL:03-6455-1183"
placeholder="電話番号"
style="margin-top:8px"
>


<input
id="shopHours"
value="営業時間：24時間営業"
placeholder="営業時間"
style="margin-top:8px"
>


<p class="note">
店舗情報を変更したい場合だけ編集してください。
</p>

</div>


<!-- PREVIEW -->

<div class="card">

<span class="step">
PREVIEW
</span>


<div class="preview-wrap">

<div
id="preview"
class="preview"
>
ここに完成した掲載ページが表示されます。
</div>

</div>

</div>


<!-- 完成HTML -->

<div class="card">

<span class="step">
STEP 3
</span>


<label>
完成した掲載用HTML
</label>


<textarea
id="output"
class="output"
readonly
placeholder="ここに完成HTMLが表示されます"
></textarea>


<button
class="copy"
onclick="copyHTML()"
>
📋 掲載用HTMLをコピー
</button>


<button
class="subbtn"
onclick="clearAll()"
>
入力をリセット
</button>

</div>


</div>


<script>


const $ =
id => document.getElementById(id);



/* =========================
   HTMLエスケープ
========================= */

function esc(value){

return String(value || "")
.replace(
/[&<>"']/g,
function(match){

return {

"&":"&amp;",
"<":"&lt;",
">":"&gt;",
'"':"&quot;",
"'":"&#39;"

}[match];

}
);

}



/* =========================
   掲載ページ作成
========================= */

function makePage(){

const source =
$("girlHtml").value.trim();


if(!source){

alert(
"女の子HTMLを貼り付けてください！"
);

return;

}


const shopName =
$("shopName").value.trim()
||
"渋谷さーくる渋谷店";


const shopTel =
$("shopTel").value.trim()
||
"TEL:03-6455-1183";


const shopHours =
$("shopHours").value.trim()
||
"営業時間：24時間営業";



/*
貼り付けられたHTMLを解析
*/

const parser =
new DOMParser();


const doc =
parser.parseFromString(
source,
"text/html"
);


/*
不要なタグを削除
*/

doc
.querySelectorAll(
"script,style,iframe,object,embed"
)
.forEach(
el => el.remove()
);


const girls =
doc.body.innerHTML.trim();



/* =========================
   完成HTML
========================= */

const finalHtml =

`
<div
style="
border:1px dotted #2dc7ff;
box-shadow:0 6px 7px #90bfd1;
"
>

<div
style="
background:
linear-gradient(
40deg,
#d1ffff,
#ffedfc 25%,
#fcffed 50%,
#ffedfc 75%,
#d1ffff
);
text-align:center;
padding:18px;
"
>


<div
style="
background:
radial-gradient(
rgba(43,216,255,.1) 10%,
transparent 20%
),
radial-gradient(
rgba(255,127,235,.1) 10%,
transparent 20%
);
background-size:40px 40px;
background-position:0 0,20px 20px;
padding:15px;
"
>


<!-- タイトル -->

<div
style="
color:#ff00ff;
font-size:26px;
font-weight:bold;
margin:4px 0 18px;
"
>

♡本日の要チェックGIRL♡

</div>


<!-- 女の子一覧 -->

<div
style="
max-width:760px;
margin:0 auto;
"
>

${girls}

</div>


<!-- 店舗情報 -->

<div
style="
margin-top:22px;
padding-top:15px;
border-top:1px dotted #ff75ca;
color:#ff00ff;
font-weight:bold;
font-size:16px;
line-height:1.8;
"
>

${esc(shopName)}<br>

${esc(shopTel)}<br>

${esc(shopHours)}

</div>


</div>

</div>

</div>
`;



/* 完成HTMLを表示 */

$("output").value =
finalHtml;


/* プレビュー */

$("preview").innerHTML =
finalHtml;


/* 完成メッセージ */

$("status").style.display =
"block";


$("status").textContent =
"✓ 完成！下の「掲載用HTMLをコピー」を押してください。";

}



/* =========================
   HTMLコピー
========================= */

async function copyHTML(){

const value =
$("output").value;


if(!value){

alert(
"先に「掲載用ページを作成する」を押してください。"
);

return;

}


try{

await navigator.clipboard.writeText(value);

alert(
"掲載用HTMLをコピーしました！✨"
);

}

catch(e){

$("output")
.removeAttribute("readonly");

$("output").select();

document.execCommand("copy");

$("output")
.setAttribute("readonly","");

alert(
"コピーしました！"
);

}

}



/* =========================
   リセット
========================= */

function clearAll(){

$("girlHtml").value = "";

$("preview").innerHTML =
"ここに完成した掲載ページが表示されます。";

$("output").value = "";

$("status").style.display =
"none";

}

</script>

</body>
</html>